# OpenStreetMap features from the Overpass API (ADR 0023). OSM data is ODbL: share-alike and attribution (shown on the
# map); fine for private use. https://wiki.openstreetmap.org/wiki/Overpass_API
OVERPASS_URL="${OVERPASS_URL:-https://overpass-api.de/api/interpreter}"
# The query box is the pilot suburbs' extent plus this margin in degrees (about 11 km per 0.1), so features just outside count.
OSM_MARGIN_DEG="${OSM_MARGIN_DEG:-0.10}"
# Beaches are searched further out, so a lot near the edge still finds its nearest one.
OSM_BEACH_MARGIN_DEG="${OSM_BEACH_MARGIN_DEG:-0.30}"
# A park must be at least 0.5 ha (spec); only parks are filtered by size.
MIN_PARK_AREA_M2="${MIN_PARK_AREA_M2:-5000}"
# An OSM beach counts as an ocean beach when it lies this close to the mapped coastline (lake and river beaches do not).
BEACH_MAX_COAST_M="${BEACH_MAX_COAST_M:-150}"
# Park area is measured within this radius of the lot (spec: 800 m); this many nearest parks are kept per lot.
PARK_RADIUS_M="${PARK_RADIUS_M:-800}"
NEAREST_PARKS="${NEAREST_PARKS:-3}"
# A suburb counts a shopping centre or supermarket when it is inside the suburb or within this many metres of it (spec: 2 km).
SUBURB_SHOPPING_RADIUS_M="${SUBURB_SHOPPING_RADIUS_M:-2000}"
