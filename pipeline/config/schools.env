SCHOOLS_URL="${SCHOOLS_URL:-https://data.nsw.gov.au/data/dataset/78c10ea3-8d04-4c9c-b255-bbf8547e37e7/resource/3e6d5f6a-055c-440d-a690-fc0537c31095/download/master_dataset.csv}"
# ICSEA has a national mean of 1000 and a standard deviation of 100; anything outside this range is treated as a typing error.
MIN_ICSEA="${MIN_ICSEA:-400}"
MAX_ICSEA="${MAX_ICSEA:-1500}"
