# NSW Valuer General bulk Property Sales Information. Free, licence CC BY-NC-ND 4.0: personal, non-commercial use only
# (see ADR 0018). Files: https://valuation.property.nsw.gov.au/embed/propertySalesInformation
SALES_BASE_URL=https://www.valuergeneral.nsw.gov.au/__psi
# Yearly zips hold a whole year of sales; weekly zips hold one week each and start on the first Monday of this year.
SALES_YEARS="2024 2025"
SALES_WEEKLY_FROM=2026-01-05
# Rules (ADR 0018): a sale counts only if it is a full-price residential sale of one property at or above this price.
MIN_SALE_PRICE_AUD="${MIN_SALE_PRICE_AUD:-50000}"
# A median is shown only when at least this many sales back it; a block size spread needs at least this many lots.
MIN_SALES_FOR_MEDIAN="${MIN_SALES_FOR_MEDIAN:-5}"
MIN_LOTS_FOR_BLOCK_SIZE="${MIN_LOTS_FOR_BLOCK_SIZE:-10}"
# Lots smaller than this (slivers) are ignored for block size.
MIN_BLOCK_AREA_M2="${MIN_BLOCK_AREA_M2:-100}"
