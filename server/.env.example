# Copy to server/.env (gitignored) and set your own key. `./gradlew :server:run` reads it.
# 127.0.0.1 = this machine only (default). Use 0.0.0.0 only on a private network you trust.
API_HOST=127.0.0.1
API_PORT=8080
# At least 16 characters; type the same value into the web app's key prompt.

API_KEY=change-me-to-a-long-random-value

# The PostGIS database that serves tiles (same credentials as pipeline/.env). Optional: without it /tiles answers 503.
# DB_URL=jdbc:postgresql://localhost:5432/homefinder
# DB_USER=homefinder
# DB_PASSWORD=the-password-from-pipeline-env
